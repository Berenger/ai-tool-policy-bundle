{
    "name": "berenger/ai-tool-policy-bundle",
    "description": "Symfony bundle providing a policy layer over the Symfony AI toolbox: tool filtering by tags, approval gating, and a debug command.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Bérenger VIDAL",
            "email": "berenger.vidal@hotmail.fr"
        }
    ],
    "keywords": [
        "symfony",
        "symfony-bundle",
        "ai",
        "llm",
        "symfony-ai",
        "tools",
        "policy",
        "approval"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "symfony/ai-agent": "^0.10.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.5",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.13.5",
        "symfony/framework-bundle": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "ToolPolicy\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ToolPolicy\\Bundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs": "phpcs",
        "cs-fix": "phpcbf"
    },
    "support": {
        "issues": "https://github.com/Berenger/ai-tool-policy-bundle/issues",
        "source": "https://github.com/Berenger/ai-tool-policy-bundle"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
